POSTGRES_USER=studygraph_user
POSTGRES_PASSWORD=studygraph_password
POSTGRES_DB=studygraph
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://studygraph_user:studygraph_password@localhost:5432/studygraph
TEST_DATABASE_URL=postgresql+psycopg://studygraph_user:studygraph_password@localhost:5432/studygraph_test
STUDYGRAPH_AUTH_SECRET=development-only-change-this-secret-change-me
STUDYGRAPH_REQUIRE_AUTH_TOKEN=false
STUDYGRAPH_DOCUMENT_STORAGE_DIR=data/documents
STUDYGRAPH_LOG_LEVEL=INFO
STUDYGRAPH_MAX_UPLOAD_BYTES=10485760
STUDYGRAPH_MAX_DOCUMENT_PAGES=500
STUDYGRAPH_MAX_DOCUMENT_CHARACTERS=1000000
STUDYGRAPH_MAX_PROCESSING_ATTEMPTS=3
STUDYGRAPH_REQUIRE_USER_HEADER=false
STUDYGRAPH_EMBEDDING_DIMENSIONS=64
